DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev
# Used outside docker; docker-compose overrides these two with service hostnames
DATABASE_URL=postgres://vozvrat:vozvrat@localhost:5432/vozvrat
REDIS_URL=redis://localhost:6379/0
IMPORT_FILE_RETENTION_DAYS=30

# LLM (Yandex AI Studio, OpenAI-compatible API)
# LLM_BACKEND: openai (real API) | fake (offline heuristic, for dev demos without a key)
LLM_BACKEND=openai
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_FOLDER_ID=
# Full URI gpt://<folder>/<model>/latest or a short name (folder is added automatically),
# e.g. qwen3-235b-a22b-fp8/latest or yandexgpt/latest; check the current list in AI Studio
LLM_MODEL_EXTRACT=
LLM_MODEL_INTENT=
LLM_PRICE_PER_1K_INPUT_RUB=
LLM_PRICE_PER_1K_OUTPUT_RUB=
LLM_MONTHLY_BUDGET_RUB=3000
LLM_CONCURRENCY=4
LLM_LOG_PAYLOADS=False
LLM_TIMEOUT_SECONDS=60
LLM_EXTRACT_BATCH_SIZE=40

# Messaging
MESSAGE_BACKEND_SMS=console
SMS_API_KEY=
SMS_SENDER_NAME=
SMS_INBOUND_SECRET=
SMS_MAX_SEGMENTS=2

# MAX messenger bot (create via https://max.ru/masterbot)
MESSAGE_BACKEND_MAX=console   # console | max
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_BOT_USERNAME=
MAX_LINK_TEMPLATE=https://max.ru/{bot}?start={payload}
