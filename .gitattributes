# Files used inside Linux containers must keep LF line endings even when the repository is
# cloned on Windows (core.autocrlf=true would otherwise break "/bin/sh\r").
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
.env.example text eol=lf
*.xlsx binary
*.woff2 binary
*.png binary
